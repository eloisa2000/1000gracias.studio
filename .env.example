# Sanity. Sin estas variables el sitio se construye igual, con los datos
# de prueba de src/data/fallback.js.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Endpoint del formulario de contacto (Formspree, Basin, función serverless...).
# Tiene que empezar con PUBLIC_ para que Astro lo exponga al script del cliente.
PUBLIC_FORM_ENDPOINT=
