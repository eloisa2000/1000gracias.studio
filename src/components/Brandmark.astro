---
/*
  La carita de 1000gracias. El SVG sangra un poco fuera de su caja de diseño
  (el trazo se sale), así que la caja mide lo del Figma y la imagen se
  posiciona con los inset negativos del nodo original.

  Gira siempre, en torno al centro del círculo de la cara y no al de la caja.

  Tiene tres formas:
  - suelta, decorativa (sin props);
  - `enlace`, que lleva a alguna parte — así va en la home;
  - `accion`, que hace algo en la página — así va dentro del muro.

  En las dos últimas, al pasar el mouse la rotación se detiene y sale un globo
  con `texto` en marquesina, que entra y sale animando el ancho igual que la
  píldora del nav.
*/
const { enlace = null, accion = null, texto = 'contacto' } = Astro.props;

const conGlobo = Boolean(enlace || accion);
const Tag = accion ? 'button' : enlace ? 'a' : 'div';

// Tres vueltas por copia: suficiente para llenar el globo con textos cortos.
const tanda = `${texto} • `.repeat(3);
---

<Tag
  class:list={['carita', conGlobo && 'carita--globo', enlace && 'carita--enlace']}
  type={accion ? 'button' : undefined}
  href={enlace ?? undefined}
  data-carita-accion={accion ?? undefined}
  aria-label={accion ?? undefined}
>
  {
    conGlobo && (
      <span class="globo" aria-hidden="true">
        <span class="globo__pista">
          <span class="globo__texto">{tanda}</span>
          <span class="globo__texto">{tanda}</span>
        </span>
      </span>
    )
  }

  <span class="brandmark">
    <img src="/svg/brandmark.svg" alt="" />
  </span>
</Tag>

<style>
  .carita {
    position: relative;
    display: block;
    flex: none;
    width: calc(124.767 * var(--k));
    height: calc(103.402 * var(--k));
  }

  /* De botón hereda cosas que acá estorban. */
  button.carita {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .brandmark {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* El SVG es un elemento reemplazado: con `inset` solo no se estira, así que
     el alto y el ancho van explícitos. */
  .brandmark img {
    position: absolute;
    left: -4.66%;
    top: -5.62%;
    width: calc(100% + 4.66% + 3.7%);
    height: calc(100% + 5.62% + 5.62%);
    max-width: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Es lo primero que aparece al cargar, antes que la lista de proyectos.
       La entrada va en la caja y el giro adentro, así no se pelean por el
       mismo `transform`. */
    .carita {
      transform-origin: 41.43% 50%;
      animation: aparece 440ms var(--ease) both;
    }

    /* En móvil la carita va al final: está abajo de todo y la home entra en
       orden descendente. En escritorio abre la secuencia, porque ahí queda
       arriba del panel. */
    @media (max-width: 1024px) {
      .carita {
        animation-delay: 700ms;
      }
    }

    .brandmark img {
      /* El centro del círculo de la cara dentro del SVG, no el de la caja. */
      transform-origin: 42.54% 50%;
      animation: gira 14s linear infinite;
    }

    .carita--globo:hover .brandmark img,
    .carita--globo:focus-visible .brandmark img,
    .carita--globo.is-activa .brandmark img {
      animation-play-state: paused;
    }
  }

  @keyframes gira {
    to {
      transform: rotate(360deg);
    }
  }

  /* Como un timbre: cae de más grande a su tamaño mientras sube de opacidad.
     Corto y frenando al final, que es lo que hace que se lea como un golpe y
     no como algo que se acerca. */
  @keyframes aparece {
    from {
      opacity: 0;
      transform: scale(1.35);
    }
  }

  /*
    Globo. Queda entero a la izquierda de la cara, con un respiro: el círculo
    empieza en -5.81 respecto de la caja, o sea a 130.58 del borde derecho, así
    que con 140 sobra lo justo para que se vea la cola. Si la cola queda detrás
    de la cara, esto se lee como una píldora y no como un globo de texto.
  */
  .globo {
    position: absolute;
    z-index: 0;
    right: calc(140 * var(--k));
    top: calc(-9 * var(--k));
    width: 0;
    height: calc(49 * var(--k));
    overflow: hidden;
    background: var(--rojo);
    -webkit-mask: url('/svg/globo.svg') 0 0 / 100% 100% no-repeat;
    mask: url('/svg/globo.svg') 0 0 / 100% 100% no-repeat;
    transition: width var(--entrada) var(--ease);
  }

  @media (hover: hover) {
    .carita--globo:hover .globo,
    .carita--globo:focus-visible .globo {
      width: calc(201 * var(--k));
    }
  }

  /* Sin hover, el primer toque saca el globo y el segundo abre. Lo lleva
     muro-modal.js. */
  .carita--globo.is-activa .globo {
    width: calc(201 * var(--k));
  }

  .globo__pista {
    display: flex;
    align-items: center;
    height: calc(44 * var(--k));
    width: max-content;
  }

  @media (prefers-reduced-motion: no-preference) {
    .globo__pista {
      animation: marquesina 9s linear infinite;
    }
  }

  .globo__texto {
    font-family: var(--tipo-rotulo);
    font-weight: 400;
    font-size: calc(16 * var(--k));
    line-height: 1;
    letter-spacing: calc(-0.5 * var(--k));
    white-space: pre;
    color: var(--crema);
  }

  @keyframes marquesina {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 1024px) {
    .carita {
      width: calc(86.542 * var(--k));
      height: calc(71.724 * var(--k));
    }

    /* Todo a escala de la carita chica: 86.542 / 124.767 = 0.6936. */
    .globo {
      right: calc(97.1 * var(--k));
      top: calc(-6.2 * var(--k));
      height: calc(34 * var(--k));
    }

    .carita--globo.is-activa .globo {
      width: calc(139.4 * var(--k));
    }

    .globo__pista {
      height: calc(30.5 * var(--k));
    }

    .globo__texto {
      font-size: calc(11.1 * var(--k));
      letter-spacing: calc(-0.35 * var(--k));
    }
  }
</style>
