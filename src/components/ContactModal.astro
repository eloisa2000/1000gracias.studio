---
import Nav from './Nav.astro';
import Star from './Star.astro';
import Titular from './Titular.astro';
import Brandmark from './Brandmark.astro';

/*
  El contacto vive en dos formas con el mismo marcado:

  - En la home es un <dialog> modal, y al abrirlo la URL pasa a /conversemos.
  - En /conversemos es la página misma, para que el enlace se pueda compartir y
    funcione sin JavaScript. Ahí no hay diálogo: es una sección fija, ya en su
    estado final, y el script del modal no se engancha (busca por id).
*/
const { ajustes, pagina = false } = Astro.props;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '';

const servicios = [
  'Portafolio',
  'Ecommerce',
  'Sitio institucional',
  'Proyecto a medida',
  'Aún no sé',
];

const Raiz = pagina ? 'section' : 'dialog';
---

<Raiz
  class:list={['contacto', pagina && 'contacto--pagina', pagina && 'is-abierto']}
  id={pagina ? undefined : 'contacto'}
  aria-labelledby="contacto-titulo"
>
  <div class="contacto__bloque">
    <div class="contacto__fondo"></div>
    <div class="contacto__festoneado">
      <img src={ajustes.contactoSrc} srcset={ajustes.contactoSrcset} alt={ajustes.contactoAlt} />
    </div>
    <div class="contacto__velo"></div>

    <Star
      variante="rellena"
      x={-290}
      y={-336}
      box={923.48}
      movil={{ x: -142, y: -176, box: 422.742 }}
      desde={{ x: -17.42, y: -79, box: 470.42 }}
      desdeMovil={{ x: -14, y: -40, box: 209.219 }}
    />
    <Star
      variante="contorno"
      x={-121.07}
      y={82.59}
      box={382.45}
      movil={{ x: -64.67, y: 15.62, box: 175.074 }}
      desde={{ x: 52, y: 126, box: 218.3 }}
      desdeMovil={{ x: 16.87, y: 51.18, box: 97.089 }}
      retardo={140}
    />

    <Titular tag="p" />
  </div>

  <div class="contacto__panel">
    <Nav tono="azul" accion="cerrar" />

    <form class="form" data-form-contacto data-correo={ajustes.email} action={endpoint} method="post">
      <h2 class="form__encabezado" id="contacto-titulo">
        <span class="form__rotulo">Déjanos tu contacto y</span>
        <span class="form__grande">Conversemos</span>
      </h2>

      <div class="form__campos">
        <div class="form__fila">
          <p class="campo">
            {/* El asterisco va con `aria-hidden`: para quien usa lector de
                pantalla el atributo `required` ya lo dice, y si no leería
                «Nombre asterisco». */}
            <label class="campo__label" for="c-nombre">
              Nombre<span class="campo__req" aria-hidden="true">*</span>
            </label>
            <input class="campo__control" id="c-nombre" name="nombre" type="text" autocomplete="name" required />
          </p>
          <p class="campo">
            <label class="campo__label" for="c-correo">
              Correo<span class="campo__req" aria-hidden="true">*</span>
            </label>
            {/* `email` y no `correo`: Formspree, Basin y compañía buscan un campo
                con ese nombre para poner el Responder-a. Con otro nombre el
                correo llega igual, pero responderlo obliga a copiar la
                dirección a mano. */}
            <input class="campo__control" id="c-correo" name="email" type="email" autocomplete="email" required />
          </p>
        </div>

        <div class="form__fila">
          <p class="campo">
            <label class="campo__label" for="c-telefono">Teléfono</label>
            <input class="campo__control" id="c-telefono" name="telefono" type="tel" autocomplete="tel" />
          </p>
          <p class="campo">
            <label class="campo__label" for="c-servicio">
              Servicio<span class="campo__req" aria-hidden="true">*</span>
            </label>
            <span class="campo__select">
              {/* El `required` funciona porque la primera opción vale "": el
                  navegador no la da por respondida. */}
              <select class="campo__control" id="c-servicio" name="servicio" required>
                <option value="">Elige una opción</option>
                {servicios.map((s) => <option value={s}>{s}</option>)}
              </select>
              <img class="campo__flecha" src="/svg/flecha.svg" alt="" aria-hidden="true" />
            </span>
          </p>
        </div>

        <p class="campo">
          <label class="campo__label" for="c-organizacion">
            Organización/Proyecto<span class="campo__req" aria-hidden="true">*</span>
          </label>
          <input class="campo__control" id="c-organizacion" name="organizacion" type="text" autocomplete="organization" required />
        </p>

        <p class="campo">
          <label class="campo__label" for="c-mensaje">
            ¿Qué tienes en mente?<span class="campo__req" aria-hidden="true">*</span>
          </label>
          <textarea class="campo__control campo__control--area" id="c-mensaje" name="mensaje" rows="5" required></textarea>
        </p>

        {/* Asunto del aviso que llega al correo. Sin esto, Formspree manda
            todos con el mismo asunto genérico y la bandeja queda ilegible. */}
        <input type="hidden" name="_subject" value="Nuevo contacto desde 1000gracias.studio" />

        {/*
          Trampa para bots. Se llama `_gotcha` y no cualquier cosa porque ese
          es el nombre que Formspree reconoce: si llega con algo escrito, lo
          descarta en su servidor. El endpoint está a la vista en el HTML, así
          que un bot puede publicar directo contra él y saltarse cualquier
          revisión que hagamos acá; por eso la que cuenta es la de allá.
        */}
        <p class="campo campo--trampa" aria-hidden="true">
          <label for="c-gotcha">No llenes este campo</label>
          <input id="c-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
        </p>

        <div class="form__envio">
          <button class="pildora pildora--rojo" type="submit">
            <span class="pildora__etiqueta">Enviar</span>
          </button>
          <p class="form__estado" data-estado role="status" aria-live="polite"></p>
        </div>
      </div>
    </form>

    <div class="contacto__brandmark">
      <Brandmark />
    </div>
  </div>
</Raiz>

<style>
  /*
    El diálogo es transparente a propósito: la home queda visible detrás y el
    bloque rojo se disuelve sobre el escenario azul en vez de aparecer de
    golpe. El titular está en los dos lados, en la misma posición, así que no
    parpadea: se queda quieto mientras todo lo demás se mueve.
  */
  .contacto {
    width: 100vw;
    max-width: 100vw;
    height: 100svh;
    max-height: 100svh;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--navy);
    overflow: hidden;
  }

  .contacto[open],
  .contacto--pagina {
    display: grid;
    grid-template-columns: 51.91% 1fr; /* 897 / 1728 */
  }

  .contacto::backdrop {
    background: none;
  }

  /* En /conversemos la sección no está en el top layer, así que se fija ella
     misma sobre la home, que queda de fondo. */
  .contacto--pagina {
    position: fixed;
    inset: 0;
    z-index: 10;
  }

  /*
    Bloque rojo con la imagen festoneada.

    `isolation` no es decorativo: sin él el bloque no crea contexto de
    apilamiento propio y sus hijos con z-index —las estrellas y el titular— se
    escapan y se dibujan sobre el panel del formulario. Mientras el bloque se
    mueve no se nota, porque el transform ya crea contexto; el problema aparece
    justo al quedarse quieto.
  */
  .contacto__bloque {
    isolation: isolate;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding: 0 calc(113 * var(--k)) calc(44 * var(--k)) calc(39 * var(--k));
  }

  /* El rojo barre desde la derecha, del lado por donde se apretó, y recién
     después entra la figura del perro. */
  .contacto__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--rojo);
    clip-path: inset(0 0 0 100%);
    transition: clip-path var(--entrada) var(--ease);
  }

  /*
    Centrada de verdad, no con un `left` fijo: el ancho del bloque es un
    porcentaje del viewport, pero la figura mide en `--k`, y `--k` también se
    ajusta al alto. En una ventana baja y ancha la figura se achica y el
    bloque no, así que un `left` calculado en `--k` la dejaba corrida.
  */
  .contacto__festoneado {
    position: absolute;
    left: 0;
    right: 0;
    margin-inline: auto;
    top: calc(106.4 * var(--k));
    width: calc(881 * var(--k));
    height: calc(879.59 * var(--k));
    z-index: 1;
    opacity: 0;
    transform: scale(0.94);
    transition:
      opacity var(--entrada) var(--ease),
      transform var(--entrada) var(--ease);
    /* Sin retardo al salir: la figura se va primero y después barre el rojo.
       El retardo de entrada vive en la regla de `.is-abierto`. */
    transition-delay: 0s;
    -webkit-mask: url('/svg/festoneado.svg') 0 0 / 100% 100% no-repeat;
    mask: url('/svg/festoneado.svg') 0 0 / 100% 100% no-repeat;
  }

  /* Las estrellas parten justo donde están las de la home y viajan hasta su
     posición y tamaño de acá. El transform lo calcula Star.astro. */
  /* Cada estrella arranca su viaje con su propio retardo, para que no lleguen
     las dos a la vez. */
  .contacto :global(.estrella) {
    z-index: 4;
    transform-origin: 0 0;
    transform: translate(calc(var(--dx) * var(--k)), calc(var(--dy) * var(--k))) scale(var(--s));
    transition: transform var(--entrada) var(--ease) calc(var(--retardo) * var(--mueve));
  }

  .contacto__bloque :global(.titular) {
    z-index: 3;
  }

  /* El panel y la carita son crema opaco desde el primer cuadro: quedan
     exactamente encima de los de la home, así que tapar la lista de proyectos
     no se ve. Lo único que entra es el formulario. */
  .contacto .form {
    opacity: 0;
    transform: translateY(calc(16 * var(--k)));
    transition:
      opacity var(--entrada) var(--ease),
      transform var(--entrada) var(--ease);
  }

  .contacto.is-abierto .contacto__fondo {
    clip-path: inset(0 0 0 0);
  }

  .contacto.is-abierto .form {
    opacity: 1;
  }

  .contacto.is-abierto .contacto__festoneado {
    opacity: 1;
    transform: none;
    transition-delay: calc(130ms * var(--mueve));
  }

  .contacto.is-abierto :global(.estrella) {
    transform: none;
  }

  .contacto.is-abierto .form {
    transform: none;
  }

  /* Foco: en vez de sumar un anillo, el contorno que ya tiene el campo cambia
     de azul a amarillo y engorda un poco. */
  .campo__control:focus-visible,
  .campo__select select:focus-visible {
    outline: none;
    border-color: var(--amarillo);
    border-width: calc(4.6 * var(--k));
  }

  .contacto__festoneado img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* Igual que en el escenario: el texto alternativo no se dibuja mientras
       carga, pero sigue estando para quien lo necesita. */
    color: transparent;
  }

  .contacto__velo {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(180deg, rgba(26, 25, 55, 0) 55%, rgba(26, 25, 55, 0.45) 100%);
    transition: opacity var(--entrada) var(--ease) 0s;
  }

  .contacto.is-abierto .contacto__velo {
    opacity: 1;
    transition-delay: calc(130ms * var(--mueve));
  }

  /* Panel del formulario */
  .contacto__panel {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: calc(28 * var(--k)) calc(30 * var(--k)) calc(38 * var(--k)) calc(28 * var(--k));
    background: var(--crema);
  }

  /*
    Ni la carita ni el punto del wordmark entran acá: son copias que caen
    justo encima de las de la home, ya puestas, y si animaran su entrada se
    verían parpadear sobre las de abajo al abrir el contacto.

    En /conversemos sí entran: ahí esto es la página, no una capa sobre otra.
  */
  .contacto:not(.contacto--pagina) :global(.carita),
  .contacto:not(.contacto--pagina) :global(.wordmark__punto) {
    animation: none;
  }

  /* En el Figma la carita queda abajo a la derecha, encima del área del
     formulario, no debajo. Por eso va posicionada, no en el flujo. */
  .contacto__brandmark {
    position: absolute;
    right: calc(30 * var(--k));
    bottom: calc(38 * var(--k));
    z-index: 4;
  }

  .form {
    width: calc(755 * var(--k));
    max-width: 100%;
    margin-top: calc(50 * var(--k));
  }

  .form__encabezado {
    margin: 0;
    color: var(--azul);
    font-weight: 400;
  }

  .form__rotulo {
    display: block;
    font-family: var(--tipo-rotulo);
    font-weight: 400;
    font-size: calc(40 * var(--k));
    line-height: 1;
    letter-spacing: calc(-1.6 * var(--k));
  }

  .form__grande {
    display: block;
    margin-top: calc(3 * var(--k));
    font-family: var(--tipo-titulo);
    font-weight: 600;
    font-size: calc(75.466 * var(--k));
    line-height: 1;
    letter-spacing: calc(-4.528 * var(--k));
    text-transform: uppercase;
  }

  .form__campos {
    display: flex;
    flex-direction: column;
    gap: calc(40 * var(--k));
    margin-top: calc(30 * var(--k));
  }

  .form__fila {
    display: grid;
    grid-template-columns: 363fr 371fr;
    gap: calc(21 * var(--k));
  }

  .campo {
    margin: 0;
    min-width: 0;
  }

  .campo__label {
    display: block;
    margin-bottom: calc(19 * var(--k));
    font-family: var(--tipo-rotulo);
    font-weight: 400;
    font-size: calc(27.527 * var(--k));
    line-height: 1;
    letter-spacing: calc(-1.3764 * var(--k));
    font-feature-settings: 'salt' 1, 'case' 1;
    color: var(--azul);
  }

  .campo__req {
    color: var(--rojo);
    padding-left: calc(2 * var(--k));
  }

  .campo__control {
    display: block;
    width: 100%;
    height: calc(46.5 * var(--k));
    padding: 0 calc(18.352 * var(--k));
    border: calc(3.059 * var(--k)) solid var(--azul);
    border-radius: calc(16.931 * var(--k));
    background: none;
    color: var(--azul);
    font-family: var(--tipo-rotulo);
    font-size: calc(22 * var(--k));
    line-height: 1;
    transition:
      border-color var(--swap) var(--ease),
      border-width var(--swap) var(--ease);
  }

  .campo__control--area {
    height: calc(203 * var(--k));
    padding: calc(13.764 * var(--k)) calc(18.352 * var(--k));
    border-radius: calc(33.644 * var(--k));
    line-height: 1.3;
    resize: vertical;
  }

  .campo__select {
    position: relative;
    display: block;
  }

  .campo__select select {
    appearance: none;
    padding-right: calc(45 * var(--k));
    cursor: pointer;
  }

  .campo__flecha {
    position: absolute;
    right: calc(18.352 * var(--k));
    top: 50%;
    width: calc(12.8 * var(--k));
    height: calc(11.75 * var(--k));
    transform: translateY(-50%) rotate(180deg);
    pointer-events: none;
  }

  .campo--trampa {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__envio {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: calc(24 * var(--k));
  }

  .form__estado {
    font-family: var(--tipo-rotulo);
    font-size: calc(22 * var(--k));
    line-height: 1.3;
    color: var(--azul);
  }

  .form__estado[data-tono='error'] {
    color: var(--rojo);
  }

  .form__estado:empty {
    display: none;
  }

  @media (max-width: 1024px) {
    /*
      En móvil el contacto es una sola hoja que sube desde abajo y abre ya
      desplazada al formulario, sin importar dónde estuviera el scroll de la
      página.

      Se intentó en dos capas, una después de la otra, pero no da: la sección
      roja mide 622 y el formulario 600, o sea 1222 en una pantalla de 852. No
      caben las dos completas, así que escalonarlas obligaba a que la segunda
      tapara a la primera. Con una hoja sola quedan las dos a la vista —el
      titular y el borde del perro arriba, el formulario entero abajo— y el
      resto del rojo se alcanza con scroll.
    */
    .contacto {
      height: 100svh;
      overflow-y: auto;
      transform: translateY(100%);
      transition: transform var(--entrada) var(--ease);
    }

    .contacto.is-abierto {
      transform: none;
    }

    .contacto[open],
    .contacto--pagina {
      display: block;
    }

    /*
      El bloque llena la pantalla para que no se vea la home por detrás
      mientras sube, pero su contenido va donde lo pone el Figma: la figura
      del perro entre 36 y 420, y el titular arrancando en 426. Por eso el
      titular se ancla arriba con padding y no al fondo del bloque — abajo
      queda rojo de sobra, que el panel tapa enseguida.
    */
    /* En el flujo, con su alto natural: los 622 del Figma dejan el titular
       arrancando justo en 426 (622 − 19 de padding − 177 de alto). */
    .contacto__bloque {
      min-height: calc(622 * var(--k));
      padding: calc(19 * var(--k)) calc(16 * var(--k));
    }

    /* En móvil la figura ya casi toca los bordes, así que crece menos. */
    .contacto__festoneado {
      top: calc(35.6 * var(--k));
      width: calc(385 * var(--k));
      height: calc(384.39 * var(--k));
    }

    /*
      La hoja entra completa: adentro no se mueve nada, porque el movimiento
      es la hoja misma subiendo. El barrido lateral del rojo sumado a la
      subida se leía como si el modal viniera de la esquina.
    */
    .contacto__fondo,
    .contacto.is-abierto .contacto__fondo {
      clip-path: none;
      transition: none;
    }

    .contacto__festoneado,
    .contacto__velo,
    .contacto .form {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .contacto :global(.estrella) {
      transform: none;
      transition: none;
    }

    .campo__control:focus-visible,
    .campo__select select:focus-visible {
      border-width: calc(2.2 * var(--k));
    }

    .contacto__panel {
      display: block;
      overflow: visible;
      padding: calc(19 * var(--k)) calc(20 * var(--k)) 0;
    }

    .contacto__brandmark {
      position: static;
      display: flex;
      justify-content: flex-end;
      padding: calc(14 * var(--k)) 0 calc(40 * var(--k));
      background: var(--crema);
    }

    .form {
      width: 100%;
      margin-top: calc(16 * var(--k));
    }

    .form__rotulo {
      font-size: calc(18.607 * var(--k));
      letter-spacing: calc(-0.7443 * var(--k));
    }

    .form__grande {
      font-size: calc(35.105 * var(--k));
      letter-spacing: calc(-2.1063 * var(--k));
    }

    .form__campos {
      gap: calc(11 * var(--k));
      margin-top: calc(20 * var(--k));
    }

    .form__fila {
      grid-template-columns: 168.858fr 172.58fr;
      gap: calc(10 * var(--k));
    }

    .campo__label {
      margin-bottom: calc(7 * var(--k));
      font-size: calc(12.805 * var(--k));
      letter-spacing: calc(-0.6402 * var(--k));
    }

    .campo__control {
      height: calc(21.6 * var(--k));
      padding: 0 calc(8.5 * var(--k));
      border-width: calc(1.423 * var(--k));
      border-radius: calc(7.876 * var(--k));
      font-size: calc(11 * var(--k));
    }

    .campo__control--area {
      height: calc(94.43 * var(--k));
      padding: calc(6 * var(--k)) calc(8.5 * var(--k));
      border-radius: calc(15.651 * var(--k));
    }

    .campo__select select {
      padding-right: calc(21 * var(--k));
    }

    .campo__flecha {
      right: calc(8.5 * var(--k));
      width: calc(6.5 * var(--k));
      height: calc(6 * var(--k));
    }

    .form__envio {
      gap: calc(14 * var(--k));
      margin-top: calc(10 * var(--k));
    }

    .form__estado {
      font-size: calc(12.805 * var(--k));
    }
  }

</style>
