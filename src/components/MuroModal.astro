---
import Brandmark from './Brandmark.astro';

/*
  Las tres estrellas de la animación de carga: el destello de cinco puntas, el
  trébol de cuatro y la estrella gruesa de cinco, tal cual salen del Figma.

  Vienen remuestreadas: cada contorno se recorrió a pasos iguales de arco y se
  guardó como 120 puntos, empezando por el más alto y girando en el mismo
  sentido. Es la única forma de morfear entre formas que no comparten ni el
  número de puntas ni el tipo de curva, porque `d` solo se interpola entre
  caminos con la misma secuencia de comandos. A 62 px de pantalla cada tramo
  mide medio píxel, así que las curvas se siguen leyendo curvas.
*/
const A =
  'M130 20L130 28L130 37L130 46L130 55L130 63L130 72L130 81L130 90L132 98L135 106L140 113L146 119L154 124L162 126L171 127L180 125L188 123L196 120L204 117L213 115L221 112L229 109L238 107L246 104L238 107L229 109L221 112L213 115L204 117L196 120L188 123L180 126L172 130L165 135L160 142L156 150L155 159L155 167L157 176L161 184L166 191L171 198L176 205L181 212L186 219L191 226L197 233L202 240L197 233L191 226L186 219L181 212L176 205L171 198L166 191L161 184L154 178L147 173L139 170L130 169L121 170L113 173L106 178L99 184L94 191L89 198L84 205L79 212L74 219L69 226L63 233L58 240L63 233L69 226L74 219L79 212L84 205L89 198L94 191L99 184L103 176L105 167L105 159L104 150L100 142L95 135L88 130L80 126L72 123L64 120L56 117L47 115L39 112L31 109L22 107L14 104L22 107L31 109L39 112L47 115L56 117L64 120L72 123L80 125L89 127L98 126L106 124L114 119L120 113L125 106L128 98L130 90L130 81L130 72L130 63L130 55L130 46L130 37L130 28Z';
const B =
  'M131 14L137 14L143 16L148 17L154 20L159 23L163 26L167 31L171 35L174 40L176 46L178 51L180 57L183 62L187 67L191 71L195 75L200 78L205 81L211 83L216 85L221 87L226 90L231 94L235 98L238 103L241 108L243 114L245 119L246 125L246 131L246 137L244 143L243 148L240 154L237 159L234 163L229 167L225 171L220 174L214 176L209 178L203 180L198 183L193 187L189 191L185 195L182 200L179 205L177 211L175 216L173 221L170 226L166 231L162 235L157 238L152 241L146 243L141 245L135 246L129 246L123 246L117 244L112 243L106 240L101 237L97 234L93 229L89 225L86 220L84 214L82 209L80 203L77 198L73 193L69 189L65 185L60 182L55 179L49 177L44 175L39 173L34 170L29 166L25 162L22 157L19 152L17 146L15 141L14 135L14 129L14 123L16 117L17 112L20 106L23 101L26 97L31 93L35 89L40 86L46 84L51 82L57 80L62 77L67 73L71 69L75 65L78 60L81 55L83 49L85 44L87 39L90 34L94 29L98 25L103 22L108 19L114 17L119 15L125 14Z';
const C =
  'M78 16L84 17L90 21L95 26L101 30L106 35L111 39L116 44L122 49L127 53L132 57L139 59L146 58L152 54L158 51L164 47L170 44L176 40L182 37L188 33L194 29L200 27L207 28L213 31L217 37L218 44L216 51L213 57L211 63L208 70L205 76L203 83L200 89L197 96L195 102L195 109L199 115L204 120L209 124L214 129L219 134L225 138L230 143L235 147L240 152L245 157L246 164L244 171L240 176L234 179L227 180L220 179L213 179L206 178L199 177L192 177L185 176L179 175L172 175L165 178L160 183L157 189L155 196L152 202L149 208L147 215L144 221L141 228L138 234L134 240L128 243L122 244L115 241L110 236L108 230L106 223L105 216L103 210L101 203L100 196L98 189L97 183L95 176L90 171L84 167L77 167L70 166L63 165L56 165L49 164L42 164L36 163L29 162L22 160L17 156L14 149L14 142L18 136L23 132L29 128L35 125L41 121L47 118L53 114L59 110L65 107L70 103L74 97L75 90L74 83L72 77L71 70L69 63L68 56L66 49L64 43L63 36L63 29L66 23L71 18Z';

/*
  El muro vive en src/pages/contacto.html como página suelta y completa: tiene su
  propio reset, sus propias variables de color (con los mismos nombres que las
  del sitio) y sus propias fuentes. Por eso acá va en un `iframe` y no
  inyectado: es la única forma de que sus estilos y los del sitio no se pisen.

  El `src` no viene puesto. Son unos 350 KB entre el documento y sus imágenes,
  y no tiene sentido bajarlos mientras la home todavía se está armando: el
  script los pide cuando el navegador queda desocupado, y antes si alguien roza
  la carita. Igual el muro no se descubre hasta que el iframe avisa que
  terminó: mientras tanto se ve la estrella dando vueltas. Antes se descubría a
  los 420 ms pasara lo que pasara, y con la red lenta eso era quedarse mirando
  la trama vacía.

  La carita se repite acá adentro. Un <dialog> modal va en el top layer, así
  que nada de fuera puede quedar por encima; la copia se coloca justo sobre la
  de la página —el script le pasa su posición— y queda quieta mientras el
  fondo y el muro entran detrás. Acá adentro además sirve de algo: repone los
  papelitos del cartel, que es la única interfaz que tenía esa página.
*/
---

<dialog class="muro" id="muro" aria-label="Muro de 1000gracias">
  <div class="muro__fondo"></div>

  <iframe
    class="muro__marco"
    data-src="/contacto/"
    title="Muro de 1000gracias"
    referrerpolicy="same-origin"></iframe>

  <div class="muro__cargando" data-muro-cargando role="status">
    <span class="visualmente-oculto">Cargando el muro…</span>
    <svg class="muro__estrella" viewBox="0 0 260 260" aria-hidden="true">
      <path
        d={A}
        fill="var(--amarillo)"
        stroke="var(--navy)"
        stroke-width="2.4"
        stroke-linejoin="round"
        stroke-linecap="round">
        <animate
          attributeName="d"
          dur="3s"
          repeatCount="indefinite"
          calcMode="spline"
          keyTimes="0;0.333;0.667;1"
          keySplines="0.2 0.6 0.2 1;0.2 0.6 0.2 1;0.2 0.6 0.2 1"
          values={`${A};${B};${C};${A}`}
        />
      </path>
    </svg>
  </div>

  <div class="muro__carita" data-muro-carita>
    <Brandmark accion="Reponer los papelitos" texto="reponer papelitos" />
  </div>

  <button class="pildora muro__cerrar" type="button" data-muro="cerrar" aria-label="Cerrar el muro">
    <span class="pildora__etiqueta">X</span>
  </button>
</dialog>

<style>
  .muro {
    width: 100vw;
    max-width: 100vw;
    height: 100svh;
    max-height: 100svh;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    overflow: hidden;
  }

  .muro[open] {
    display: block;
  }

  /* Sin velo propio: el fondo de abajo es el que cubre, y se funde. */
  .muro::backdrop {
    background: none;
  }

  /*
    Primero entra la trama de transparencia, sobre la home que queda visible
    detrás. Es la misma que trae la página del muro y con la misma medida y
    desfase, así que cuando el afiche se funde encima las dos calzan y lo único
    que aparece es el poste con el cartel.

    Si allá se cambia, hay que cambiarla acá: son dos documentos distintos y no
    pueden compartir la regla.
  */
  .muro__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: #fff;
    background-image:
      linear-gradient(45deg, #cdcdcd 25%, transparent 25% 75%, #cdcdcd 75%),
      linear-gradient(45deg, #cdcdcd 25%, transparent 25% 75%, #cdcdcd 75%);
    background-position:
      0 0,
      13px 13px;
    background-size: 26px 26px;
    opacity: 0;
    /* El retardo de la base es el de salida: al cerrar el fondo se va después
       del afiche. Al abrir manda la regla de `.is-abierto`, sin retardo. */
    transition: opacity var(--entrada) var(--ease) calc(var(--entrada) * var(--mueve));
  }

  .muro.is-abierto .muro__fondo {
    opacity: 1;
    transition-delay: 0s;
  }

  /* Y después el muro con el afiche. El retardo de entrada vive en la regla
     de `.is-abierto` y el de salida en la base, así al cerrar el orden se
     invierte solo: primero se va el afiche, después el fondo. */
  .muro__marco {
    display: block;
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 0;
    /* Solo fundido, sin desplazamiento: si se moviera, su trama se correría
       respecto de la de abajo y se vería el arrastre. */
    opacity: 0;
    transition: opacity var(--entrada) var(--ease) 0s;
  }

  .muro.is-abierto.is-cargado .muro__marco {
    opacity: 1;
    transition-delay: calc(var(--entrada) * var(--mueve));
  }

  /*
    Mientras no llega. Entra con el mismo retardo que llevaría el muro, así
    que si el iframe ya estaba pedido y contesta rápido no alcanza a verse:
    `is-cargado` llega antes de que empiece su transición.
  */
  .muro__cargando {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--entrada) var(--ease) 0s,
      visibility 0s linear var(--entrada);
    pointer-events: none;
  }

  .muro.is-abierto:not(.is-cargado) .muro__cargando {
    opacity: 1;
    visibility: visible;
    transition-delay: calc(var(--entrada) * var(--mueve)), 0s;
  }

  /* 140 y no 96: el destello son astillas de medio píxel de grueso, y más
     chico se pierden. */
  .muro__estrella {
    width: calc(140 * var(--k));
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .muro__estrella {
      animation: gira-la-carga 9s linear infinite;
    }
  }

  @keyframes gira-la-carga {
    to {
      transform: rotate(360deg);
    }
  }

  /* La carita: encima de todo y quieta. El script le pone la posición exacta
     de la de la página, así al abrir no se mueve ni un píxel. */
  .muro__carita {
    position: absolute;
    z-index: 3;
  }

  /* Sin animación de entrada: esta copia no aparece, ya está. El giro sí sigue,
     y va en fase con el de la página porque las dos partieron a la vez. */
  .muro__carita :global(.carita) {
    animation: none;
  }

  .muro__cerrar {
    position: absolute;
    z-index: 2;
    top: calc(28 * var(--k));
    right: calc(30 * var(--k));
    color: var(--azul);
    opacity: 0;
    transition: opacity var(--entrada) var(--ease) 0s;
  }

  .muro.is-abierto .muro__cerrar {
    opacity: 1;
    transition-delay: calc(var(--entrada) * var(--mueve));
  }

  @media (hover: hover) {
    .muro__cerrar:hover {
      background: var(--azul);
      border-color: var(--azul);
      color: var(--crema);
    }
  }

  @media (max-width: 1024px) {
    .muro__cerrar {
      top: calc(19 * var(--k));
      right: calc(16 * var(--k));
    }
  }
</style>
