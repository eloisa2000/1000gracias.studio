---
import Brandmark from './Brandmark.astro';

// Las tres estrellas de la animación de carga. Ver la nota en el <svg>.
const A =
  'M133.8 19.0L159.6 66.2C164.0 74.4 172.4 80.5 181.5 82.2L234.4 92.1C239.2 93.0 240.1 95.7 236.7 99.3L199.8 138.4C193.4 145.2 190.2 155.0 191.4 164.2L198.3 217.5C199.0 222.4 196.6 224.2 192.1 222.0L143.6 199.0C135.1 195.0 124.9 195.0 116.4 199.0L67.9 222.0C63.4 224.2 61.0 222.4 61.7 217.5L68.6 164.2C69.8 155.0 66.6 145.2 60.2 138.4L23.3 99.3C19.9 95.7 20.8 93.0 25.6 92.1L78.5 82.2C87.6 80.5 96.0 74.4 100.4 66.2L126.2 19.0C128.5 14.7 131.5 14.7 133.8 19.0Z';
const B =
  'M155.1 30.5L168.5 49.2C177.9 62.3 192.3 75.3 206.3 83.2L226.3 94.6C238.2 101.3 240.5 112.2 232.4 123.2L218.7 141.7C209.2 154.7 201.3 172.3 198.1 188.1L193.4 210.6C190.7 224.0 181.1 229.6 168.1 225.3L146.3 218.0C131.0 212.9 111.8 210.9 95.8 212.7L72.9 215.2C59.4 216.8 51.1 209.3 51.2 195.7L51.3 172.7C51.4 156.6 47.4 137.7 40.8 123.0L31.3 102.0C25.7 89.6 30.2 79.5 43.2 75.3L65.1 68.4C80.5 63.5 97.2 53.9 109.1 43.0L126.1 27.5C136.2 18.3 147.2 19.4 155.1 30.5Z';
const C =
  'M155.0 19.6L162.2 89.1C162.9 95.8 167.4 100.9 174.1 102.3L242.5 116.6C245.5 117.3 245.6 118.4 242.8 119.7L178.9 148.0C172.7 150.7 169.3 156.6 170.0 163.4L177.5 232.8C177.8 235.9 176.7 236.4 174.7 234.1L128.0 182.1C123.5 177.0 116.9 175.6 110.6 178.4L46.9 206.9C44.0 208.2 43.3 207.3 44.8 204.6L79.9 144.2C83.3 138.3 82.6 131.6 78.0 126.5L31.2 74.7C29.1 72.4 29.7 71.4 32.7 72.1L101.0 86.7C107.7 88.2 113.8 85.4 117.2 79.5L152.0 18.9C153.6 16.2 154.7 16.5 155.0 19.6Z';

/*
  El muro vive en src/pages/contacto.html como página suelta y completa: tiene su
  propio reset, sus propias variables de color (con los mismos nombres que las
  del sitio) y sus propias fuentes. Por eso acá va en un `iframe` y no
  inyectado: es la única forma de que sus estilos y los del sitio no se pisen.

  El `src` no viene puesto. Son unos 350 KB entre el documento y sus imágenes,
  y no tiene sentido bajarlos mientras la home todavía se está armando: el
  script los pide cuando el navegador queda desocupado, y antes si alguien roza
  la carita. Igual el muro no se descubre hasta que el iframe avisa que
  terminó: mientras tanto se ve la estrella dando vueltas. Antes se descubría a
  los 420 ms pasara lo que pasara, y con la red lenta eso era quedarse mirando
  la trama vacía.

  La carita se repite acá adentro. Un <dialog> modal va en el top layer, así
  que nada de fuera puede quedar por encima; la copia se coloca justo sobre la
  de la página —el script le pasa su posición— y queda quieta mientras el
  fondo y el muro entran detrás. Acá adentro además sirve de algo: repone los
  papelitos del cartel, que es la única interfaz que tenía esa página.
*/
---

<dialog class="muro" id="muro" aria-label="Muro de 1000gracias">
  <div class="muro__fondo"></div>

  <iframe
    class="muro__marco"
    data-src="/contacto/"
    title="Muro de 1000gracias"
    referrerpolicy="same-origin"></iframe>

  <div class="muro__cargando" data-muro-cargando role="status">
    <span class="visualmente-oculto">Cargando el muro…</span>
    <svg class="muro__estrella" viewBox="0 0 260 260" aria-hidden="true">
      {/* Las tres formas tienen la misma secuencia de comandos —M, diez pares
           L+C, Z— porque es la condición para que `d` se pueda interpolar de
           una a otra. Salen de un generador: la misma estrella de cinco puntas
           con el radio interior y el redondeo distintos, más un octavo de
           punta de giro entre cada una. */}
      <path
        d={A}
        fill="var(--amarillo)"
        stroke="var(--navy)"
        stroke-width="2"
        stroke-linejoin="round">
        <animate
          attributeName="d"
          dur="2.4s"
          repeatCount="indefinite"
          calcMode="spline"
          keyTimes="0;0.333;0.667;1"
          keySplines="0.2 0.6 0.2 1;0.2 0.6 0.2 1;0.2 0.6 0.2 1"
          values={`${A};${B};${C};${A}`}
        />
      </path>
    </svg>
  </div>

  <div class="muro__carita" data-muro-carita>
    <Brandmark accion="Reponer los papelitos" texto="reponer papelitos" />
  </div>

  <button class="pildora muro__cerrar" type="button" data-muro="cerrar" aria-label="Cerrar el muro">
    <span class="pildora__etiqueta">X</span>
  </button>
</dialog>

<style>
  .muro {
    width: 100vw;
    max-width: 100vw;
    height: 100svh;
    max-height: 100svh;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    overflow: hidden;
  }

  .muro[open] {
    display: block;
  }

  /* Sin velo propio: el fondo de abajo es el que cubre, y se funde. */
  .muro::backdrop {
    background: none;
  }

  /*
    Primero entra la trama de transparencia, sobre la home que queda visible
    detrás. Es la misma que trae la página del muro y con la misma medida y
    desfase, así que cuando el afiche se funde encima las dos calzan y lo único
    que aparece es el poste con el cartel.

    Si allá se cambia, hay que cambiarla acá: son dos documentos distintos y no
    pueden compartir la regla.
  */
  .muro__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: #fff;
    background-image:
      linear-gradient(45deg, #cdcdcd 25%, transparent 25% 75%, #cdcdcd 75%),
      linear-gradient(45deg, #cdcdcd 25%, transparent 25% 75%, #cdcdcd 75%);
    background-position:
      0 0,
      13px 13px;
    background-size: 26px 26px;
    opacity: 0;
    /* El retardo de la base es el de salida: al cerrar el fondo se va después
       del afiche. Al abrir manda la regla de `.is-abierto`, sin retardo. */
    transition: opacity var(--entrada) var(--ease) calc(var(--entrada) * var(--mueve));
  }

  .muro.is-abierto .muro__fondo {
    opacity: 1;
    transition-delay: 0s;
  }

  /* Y después el muro con el afiche. El retardo de entrada vive en la regla
     de `.is-abierto` y el de salida en la base, así al cerrar el orden se
     invierte solo: primero se va el afiche, después el fondo. */
  .muro__marco {
    display: block;
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 0;
    /* Solo fundido, sin desplazamiento: si se moviera, su trama se correría
       respecto de la de abajo y se vería el arrastre. */
    opacity: 0;
    transition: opacity var(--entrada) var(--ease) 0s;
  }

  .muro.is-abierto.is-cargado .muro__marco {
    opacity: 1;
    transition-delay: calc(var(--entrada) * var(--mueve));
  }

  /*
    Mientras no llega. Entra con el mismo retardo que llevaría el muro, así
    que si el iframe ya estaba pedido y contesta rápido no alcanza a verse:
    `is-cargado` llega antes de que empiece su transición.
  */
  .muro__cargando {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--entrada) var(--ease) 0s,
      visibility 0s linear var(--entrada);
    pointer-events: none;
  }

  .muro.is-abierto:not(.is-cargado) .muro__cargando {
    opacity: 1;
    visibility: visible;
    transition-delay: calc(var(--entrada) * var(--mueve)), 0s;
  }

  .muro__estrella {
    width: calc(96 * var(--k));
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .muro__estrella {
      animation: gira-la-carga 9s linear infinite;
    }
  }

  @keyframes gira-la-carga {
    to {
      transform: rotate(360deg);
    }
  }

  /* La carita: encima de todo y quieta. El script le pone la posición exacta
     de la de la página, así al abrir no se mueve ni un píxel. */
  .muro__carita {
    position: absolute;
    z-index: 3;
  }

  /* Sin animación de entrada: esta copia no aparece, ya está. El giro sí sigue,
     y va en fase con el de la página porque las dos partieron a la vez. */
  .muro__carita :global(.carita) {
    animation: none;
  }

  .muro__cerrar {
    position: absolute;
    z-index: 2;
    top: calc(28 * var(--k));
    right: calc(30 * var(--k));
    color: var(--azul);
    opacity: 0;
    transition: opacity var(--entrada) var(--ease) 0s;
  }

  .muro.is-abierto .muro__cerrar {
    opacity: 1;
    transition-delay: calc(var(--entrada) * var(--mueve));
  }

  @media (hover: hover) {
    .muro__cerrar:hover {
      background: var(--azul);
      border-color: var(--azul);
      color: var(--crema);
    }
  }

  @media (max-width: 1024px) {
    .muro__cerrar {
      top: calc(19 * var(--k));
      right: calc(16 * var(--k));
    }
  }
</style>
