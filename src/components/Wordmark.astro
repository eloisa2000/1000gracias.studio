---
import { enLinea } from '../lib/svg.js';
import puntoSvg from '../../public/svg/punto.svg?raw';

const { tono = 'azul', tag = 'span' } = Astro.props;
const Tag = tag;
---

<Tag class:list={['wordmark', `wordmark--${tono}`]}>
  <span class="wordmark__punto" aria-hidden="true" set:html={enLinea(puntoSvg)} />1000gracias
</Tag>

<style>
  .wordmark {
    position: relative;
    display: inline-block;
    padding-left: calc(30.22 * var(--k));
    font-family: var(--tipo-rotulo);
    font-weight: 500;
    font-size: calc(35.745 * var(--k));
    line-height: 1.5;
    letter-spacing: calc(-2.8596 * var(--k));
    white-space: nowrap;
  }

  .wordmark--azul {
    color: var(--azul);
  }

  .wordmark--crema {
    color: var(--crema);
  }

  .wordmark__punto {
    position: absolute;
    left: 0;
    top: calc(10.21 * var(--k));
    width: calc(30.222 * var(--k));
    height: calc(30.222 * var(--k));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wordmark__punto :global(svg) {
    width: 78.271%;
    height: 63.149%;
    transform: rotate(-45deg);
  }

  /* El punto se funde solo, un poco después de la palabra. `backwards`: no
     hay nada que sostener al final. */
  @media (prefers-reduced-motion: no-preference) {
    .wordmark__punto {
      animation: enciende 700ms var(--ease) 90ms backwards;
    }

    /* En móvil el wordmark entero ya entra a los 210 ms (ver Nav): el punto
       llega después, no junto. */
    @media (max-width: 1024px) {
      .wordmark__punto {
        animation-delay: 300ms;
      }
    }
  }

  @keyframes enciende {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 1024px) {
    .wordmark {
      padding-left: calc(14.23 * var(--k));
      font-size: calc(16.826 * var(--k));
      letter-spacing: calc(-1.3461 * var(--k));
    }

    .wordmark__punto {
      top: calc(4.81 * var(--k));
      width: calc(14.226 * var(--k));
      height: calc(14.226 * var(--k));
    }
  }
</style>
