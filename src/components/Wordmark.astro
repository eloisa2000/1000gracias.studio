---
const { tono = 'azul', tag = 'span' } = Astro.props;
const Tag = tag;
---

<Tag class:list={['wordmark', `wordmark--${tono}`]}>
  <span class="wordmark__punto" aria-hidden="true">
    <img src="/svg/punto.svg" alt="" />
  </span>1000gracias
</Tag>

<style>
  .wordmark {
    position: relative;
    display: inline-block;
    padding-left: calc(30.22 * var(--k));
    font-family: var(--tipo-rotulo);
    font-weight: 500;
    font-size: calc(35.745 * var(--k));
    line-height: 1.5;
    letter-spacing: calc(-2.8596 * var(--k));
    white-space: nowrap;
  }

  .wordmark--azul {
    color: var(--azul);
  }

  .wordmark--crema {
    color: var(--crema);
  }

  .wordmark__punto {
    position: absolute;
    left: 0;
    top: calc(10.21 * var(--k));
    width: calc(30.222 * var(--k));
    height: calc(30.222 * var(--k));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wordmark__punto img {
    width: 78.271%;
    height: 63.149%;
    transform: rotate(-45deg);
  }

  @media (max-width: 1024px) {
    .wordmark {
      padding-left: calc(14.23 * var(--k));
      font-size: calc(16.826 * var(--k));
      letter-spacing: calc(-1.3461 * var(--k));
    }

    .wordmark__punto {
      top: calc(4.81 * var(--k));
      width: calc(14.226 * var(--k));
      height: calc(14.226 * var(--k));
    }
  }
</style>
