---
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/onest/latin-400.css';
import '@fontsource/onest/latin-500.css';
import '../styles/tokens.css';
import '../styles/global.css';

const {
  title = '1000gracias — Diseño web para bien público, cultura y oficios',
  description = 'Estudio de diseño web. Trabajamos con organizaciones, colectivos y personas en cultura, educación, medio ambiente y causas sociales.',
  imagen = '/img/compartir.jpg',
  imagenAlt = 'Detalle del naipe de la Muerte del tarot Visconti di Modrone sobre un bloque azul.',
  conDatosDelEstudio = false,
} = Astro.props;

/*
  La canónica se arma con `site` (astro.config.mjs) y siempre con barra al
  final, que es como quedan las rutas en el build: /conversemos/index.html se
  sirve en /conversemos/. Sin esto, la misma página con y sin barra cuentan
  como dos direcciones distintas.
*/
const canonica = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const imagenAbsoluta = new URL(imagen, Astro.site).href;

const estudio = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: '1000gracias',
  description,
  url: Astro.site?.href,
  image: imagenAbsoluta,
  areaServed: 'CL',
  knowsLanguage: 'es',
  slogan: 'Diseño web para proyectos de bien público, cultura y oficios',
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#1e1a8e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:site_name" content="1000gracias" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imagenAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenAbsoluta} />
    <meta name="twitter:image:alt" content={imagenAlt} />

    {
      conDatosDelEstudio && (
        <script type="application/ld+json" set:html={JSON.stringify(estudio)} />
      )
    }

    {/* Marca que hay JavaScript antes del primer pintado. Lo usa el fundido de
        la imagen del escenario: sin esto habría que esconderla de entrada, y
        si el script fallara no aparecería nunca. */}
    <script is:inline>
      document.documentElement.classList.add('con-js');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
